# Copy to .env (git-ignored) and fill ONLY what you use. Values are never read from config files.
SERPER_API_KEY=

# LLM providers (pick one; select it with --llm <preset>):
GEMINI_API_KEY=          # https://aistudio.google.com/apikey   (free tier)   -> --llm gemini
GROQ_API_KEY=            # https://console.groq.com/keys        (free tier)   -> --llm groq
OPENROUTER_API_KEY=      # https://openrouter.ai/keys                          -> --llm openrouter
OPENAI_API_KEY=          #                                                     -> --llm openai
ANTHROPIC_API_KEY=       # needs API credit                                    -> --llm anthropic (JSON stages only; no agent adapter yet)
# ollama needs no key (local)                                                    -> --llm ollama
